# 复制为 backend/.env 后填写。密钥只放在 .env，不写入代码或日志。
# LLM_BASE_URL 留空时按 LLM_PROVIDER 自动选择：
# glm → https://open.bigmodel.cn/api/paas/v4；deepseek → https://api.deepseek.com。
# LLM_PROVIDER=deepseek 且 LLM_API_KEY 留空时，使用下面的 DEEPSEEK_API_KEY。
LLM_BASE_URL=
LLM_API_KEY=
LLM_PROVIDER=glm
LLM_MODEL_TUTOR=glm-5.3-flash

# DeepSeek：web_search / web_fetch 联网工具使用；LLM_PROVIDER=deepseek 且
# LLM_API_KEY 留空时，聊天供应商也用这把 key。BASE_URL 一般不用改。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 运行时数据目录；相对路径按 backend/ 解析。默认 ../data（仓库根目录下）。
DATA_DIR=../data
# 规则目录（框架 YAML）；相对路径按 backend/ 解析。默认 ../config。
CONFIG_DIR=../config

# 登录会话有效期（小时）与 cookie 是否要求 HTTPS。
SESSION_TTL_HOURS=168
COOKIE_SECURE=false

# 一个学生同时在后台生成回复的对话数上限（切到别的对话时，原对话继续生成）。
MAX_CONCURRENT_RUNS_PER_USER=3
