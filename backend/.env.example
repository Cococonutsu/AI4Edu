# 复制为 backend/.env 后填写。密钥只放在 .env，不写入代码或日志。
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL_TUTOR=glm-5.3-flash
LLM_MODEL_ANALYZER=glm-5.3-flash

# 运行时数据目录；相对路径按 backend/ 解析。默认 ../data（仓库根目录下）。
DATA_DIR=../data
# 规则与提示词目录；相对路径按 backend/ 解析。默认 ../config。
CONFIG_DIR=../config

# 登录会话有效期（小时）与 cookie 是否要求 HTTPS。
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
